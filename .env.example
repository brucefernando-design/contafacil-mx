# EasyConta MX - Variables de Entorno Ejemplo
DATABASE_URL="postgresql://postgres:postgresPassword2026!@localhost:5432/contafacil_mx?schema=public"
NEXTAUTH_SECRET="tu-clave-secreta-minimo-32-caracteres-sat2026"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Clave obligatoria AES-256-GCM para la bóveda de certificados SAT (CSD / e.firma)
CERT_VAULT_KEY="contafacil-sat-aes256-gcm-vault-key-32chars!"

# ─────────────────────────────────────────────────────────────────────────────
# Proveedor Autorizado de Certificación (PAC) – CFDI 4.0
#
# PAC_ENV  : mock (demo, sin HTTP) | sandbox (apisandbox.facturama.mx) | production (api.facturama.mx)
# PAC_BASE_URL : override opcional; si se omite se deriva de PAC_ENV automáticamente
#   production → https://api.facturama.mx
#   sandbox    → https://apisandbox.facturama.mx
#
# IMPORTANTE: PAC_ENV=production requiere FACTURAMA_USER y FACTURAMA_PASSWORD.
#             Si faltan, el timbrado lanzará error y no se enviará nada al SAT.
# NO commitees este archivo con credenciales reales. Usa siempre .env (local).
# ─────────────────────────────────────────────────────────────────────────────
PAC_ENV=mock
FACTURAMA_USER=
FACTURAMA_PASSWORD=
# PAC_BASE_URL=   # Opcional; sobrescribe la URL derivada de PAC_ENV

# ─────────────────────────────────────────────────────────────────────────────
# Resend – Envío de correos transaccionales
# Obtén tu API key en: https://resend.com/api-keys
# Si no tienes dominio verificado usa: onboarding@resend.dev (sandbox)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="EasyConta MX <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────────────────────
# MercadoPago – Checkout Pro
# Sandbox:  usa APP_USR-... del panel developers.mercadopago.com
# Producción: reemplaza por las credenciales de producción cuando estés listo
# ─────────────────────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN="APP_USR-..."
MP_PUBLIC_KEY="APP_USR-..."
# Firma para validar webhooks (opcional en sandbox, requerido en producción)
# MP_WEBHOOK_SECRET="tu_webhook_secret"

# Clave pública expuesta al cliente (para el SDK de MercadoPago en el browser)
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
