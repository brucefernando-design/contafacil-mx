# EasyConta MX - Variables de Entorno Ejemplo
DATABASE_URL="postgresql://postgres:postgresPassword2026!@localhost:5432/contafacil_mx?schema=public"
NEXTAUTH_SECRET="tu-clave-secreta-minimo-32-caracteres-sat2026"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Clave obligatoria AES-256-GCM para la bóveda de certificados SAT (CSD / e.firma)
CERT_VAULT_KEY="contafacil-sat-aes256-gcm-vault-key-32chars!"

# Configuración del Proveedor Autorizado de Certificación (PAC CFDI 4.0)
# Opciones: 'mock' (simulación local SAT 2026) | 'http' (PAC comercial Facturama / SW Sapien)
PAC_MODE=mock
PAC_BASE_URL="https://api.facturama.com.mx"
# PAC_API_KEY="tu_api_key_comercial_aqui"

