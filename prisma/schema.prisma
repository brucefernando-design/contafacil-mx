generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONTADOR
  ADMIN
}

enum TipoPersona {
  PF
  PM
}

enum Plan {
  FREE
  PRO
  DESPACHO
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  name             String
  password         String
  role             Role                 @default(USER)
  isDespacho       Boolean              @default(false)
  activeCompanyId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  memberships      OrganizationMember[]
  subscription     Subscription?
  auditLogs        AuditLog[]

  @@map("users")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             Plan      @default(FREE)
  status           String    @default("ACTIVE") // "ACTIVE", "TRIAL", "CANCELLED"
  periodEnd        DateTime?
  timbresIncluidos Int       @default(10)
  timbresUsados    Int       @default(0)
  mpPaymentId      String?   // último payment_id de MercadoPago
  mpStatus         String?   // "approved", "pending", "rejected"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Organization {
  id                   String               @id @default(cuid())
  rfc                  String               @unique
  razonSocial          String
  tipoPersona          TipoPersona          @default(PF)
  regimenFiscal        String               // "626" RESICO, "612" Actividad Empresarial, "606" Arrendamiento, "601" PM General
  codigoPostal         String               // 5 dígitos
  calle                String?
  colonia              String?
  municipio            String?
  estado               String?
  coeficienteUtilidad  Decimal?             @default(0.0825) @db.Decimal(8, 4) // Para PM General
  deduccionCiega       Boolean              @default(true)   // Para Arrendamiento PF (35%)
  csdStatus            String               @default("ACTIVO") // "ACTIVO", "PENDIENTE", "REVOCADO"
  csdNoCertificado     String?              @default("30001000000500003416")
  csdVencimiento       DateTime?
  serieDefault         String               @default("F")
  folioActual          Int                  @default(1)
  opinionCumplimiento  String               @default("POSITIVA") // "POSITIVA", "NEGATIVA"
  efosStatus           String               @default("LIMPIO")   // "LIMPIO", "EN_OBSERVACION"
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  members              OrganizationMember[]
  invoices             Invoice[]
  polizas              Poliza[]
  taxDeclarations      TaxDeclarationMonth[]
  fiscalAlerts         FiscalAlert[]
  catalogAccounts      SatCatalogAccount[]
  bankTransactions     BankTransaction[]
  certificates         CertificateVault[]
  auditLogs            AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER") // "OWNER", "CONTADOR", "AUXILIAR"
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Invoice {
  id                   String              @id @default(cuid())
  organizationId       String
  tipo                 String              // "EMITIDA", "RECIBIDA"
  tipoDeComprobante    String              @default("I") // "I" Ingreso, "E" Egreso, "P" Pago, "T" Traslado, "N" Nomina
  serie                String?
  folio                String?
  uuid                 String              @unique
  fecha                DateTime
  formaPago            String              @default("03") // "01" Efectivo, "03" Transferencia, "04" Tarjeta, "99" Por definir
  metodoPago           String              @default("PUE") // "PUE", "PPD"
  lugarExpedicion      String              // Código Postal
  moneda               String              @default("MXN")
  tipoCambio           Decimal             @default(1.0) @db.Decimal(12, 4)
  subtotal             Decimal             @db.Decimal(14, 2)
  descuento            Decimal             @default(0.0) @db.Decimal(14, 2)
  total                Decimal             @db.Decimal(14, 2)
  
  // Emisor
  emisorRfc            String
  emisorNombre         String
  emisorRegimen        String
  
  // Receptor
  receptorRfc          String
  receptorNombre       String
  receptorCp           String
  receptorRegimen      String
  receptorUsoCfdi      String              @default("G03")
  
  // Impuestos
  totalIvaTrasladado   Decimal             @default(0.0) @db.Decimal(14, 2)
  totalIvaRetenido     Decimal             @default(0.0) @db.Decimal(14, 2)
  totalIsrRetenido     Decimal             @default(0.0) @db.Decimal(14, 2)
  
  // Estatus SAT
  estatus              String              @default("VIGENTE") // "VIGENTE", "CANCELADO"
  fechaTimbrado        DateTime?
  selloCFD             String?             @db.Text
  selloSAT             String?             @db.Text
  noCertificadoSAT     String?             @default("00001000000504465028")
  cadenaOriginal       String?             @db.Text
  qrCodeData           String?             @db.Text
  rawXml               String?             @db.Text
  
  // Conciliación PUE / PPD
  saldoPendiente       Decimal             @default(0.0) @db.Decimal(14, 2)
  fechaEfectivoCobro   DateTime?
  estaConciliada       Boolean             @default(false)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items                InvoiceItem[]
  paymentComplements   PaymentComplement[] @relation("InvoicePpd")
  polizas              Poliza[]

  @@index([organizationId, tipo, fecha])
  @@index([uuid])
  @@index([emisorRfc])
  @@index([receptorRfc])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  claveProdServ  String   // Ej. "80141600" Servicios contables
  claveUnidad    String   @default("E48")
  unidad         String?  @default("Servicio")
  descripcion    String
  cantidad       Decimal  @default(1.0) @db.Decimal(12, 4)
  valorUnitario  Decimal  @db.Decimal(14, 2)
  importe        Decimal  @db.Decimal(14, 2)
  descuento      Decimal  @default(0.0) @db.Decimal(14, 2)
  objetoImp      String   @default("02") // 01 No objeto, 02 Sí objeto
  ivaTasa        Decimal  @default(0.16) @db.Decimal(8, 4)
  ivaImporte     Decimal  @default(0.0) @db.Decimal(14, 2)
  retIsrTasa     Decimal? @default(0.0) @db.Decimal(8, 4)
  retIsrImporte  Decimal? @default(0.0) @db.Decimal(14, 2)
  retIvaTasa     Decimal? @default(0.0) @db.Decimal(8, 4)
  retIvaImporte  Decimal? @default(0.0) @db.Decimal(14, 2)

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model PaymentComplement {
  id             String   @id @default(cuid())
  invoicePpdId   String   // Factura original PPD
  uuidPago       String?  // UUID del CFDI tipo Pago emitido
  fechaPago      DateTime
  formaPago      String   @default("03") // SPEI
  monto          Decimal  @db.Decimal(14, 2)
  numParcialidad Int      @default(1)
  saldoAnterior  Decimal  @db.Decimal(14, 2)
  saldoInsoluto  Decimal  @db.Decimal(14, 2)
  monedaPago     String   @default("MXN")
  createdAt      DateTime @default(now())

  invoicePpd     Invoice  @relation("InvoicePpd", fields: [invoicePpdId], references: [id], onDelete: Cascade)

  @@map("payment_complements")
}

model Poliza {
  id               String        @id @default(cuid())
  organizationId   String
  invoiceId        String?
  tipo             String        // "INGRESO", "EGRESO", "DIARIO"
  numero           Int
  fecha            DateTime
  concepto         String
  uuidRelacionado  String?
  totalDebe        Decimal       @default(0.0) @db.Decimal(14, 2)
  totalHaber       Decimal       @default(0.0) @db.Decimal(14, 2)
  estaCuadrada     Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  entries          PolizaEntry[]

  @@map("polizas")
}

model PolizaEntry {
  id           String  @id @default(cuid())
  polizaId     String
  cuentaCodigo String  // Código Agrupador SAT, ej: 102.01, 105.01, 401.01
  cuentaNombre String
  concepto     String?
  debe         Decimal @default(0.0) @db.Decimal(14, 2)
  haber        Decimal @default(0.0) @db.Decimal(14, 2)

  poliza       Poliza  @relation(fields: [polizaId], references: [id], onDelete: Cascade)

  @@map("poliza_entries")
}

model SatCatalogAccount {
  id             String       @id @default(cuid())
  organizationId String
  codigoSat      String       // Ej. 102.01, 105.01, 201.01, 401.01
  nombre         String
  tipo           String       // "ACTIVO", "PASIVO", "CAPITAL", "RESULTADOS_ACREEDORA", "RESULTADOS_DEUDORA"
  nivel          Int          @default(2)
  saldoInicial   Decimal      @default(0.0) @db.Decimal(14, 2)
  cargos         Decimal      @default(0.0) @db.Decimal(14, 2)
  abonos         Decimal      @default(0.0) @db.Decimal(14, 2)
  saldoFinal     Decimal      @default(0.0) @db.Decimal(14, 2)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, codigoSat])
  @@map("sat_catalog_accounts")
}

model TaxDeclarationMonth {
  id                         String       @id @default(cuid())
  organizationId             String
  year                       Int          @default(2026)
  month                      Int          // 1 - 12
  regimen                    String       // "626", "612", "606", "601"
  ingresosCobrados           Decimal      @default(0.0) @db.Decimal(14, 2)
  deduccionesPagadas         Decimal      @default(0.0) @db.Decimal(14, 2)
  baseGravable               Decimal      @default(0.0) @db.Decimal(14, 2)
  tasaIsr                    Decimal      @default(0.0) @db.Decimal(8, 4)
  isrDeterminado             Decimal      @default(0.0) @db.Decimal(14, 2)
  retencionesIsr             Decimal      @default(0.0) @db.Decimal(14, 2)
  pagosProvisionalesPrevios  Decimal      @default(0.0) @db.Decimal(14, 2)
  isrAPagar                  Decimal      @default(0.0) @db.Decimal(14, 2)
  ivaCobrado                 Decimal      @default(0.0) @db.Decimal(14, 2)
  ivaPagado                  Decimal      @default(0.0) @db.Decimal(14, 2)
  retencionesIva             Decimal      @default(0.0) @db.Decimal(14, 2)
  ivaAPagar                  Decimal      @default(0.0) @db.Decimal(14, 2)
  estatus                    String       @default("CALCULADO") // "CALCULADO", "PRESENTADA", "PAGADA"
  lineaCaptura               String?
  fechaLimite                DateTime?
  fechaPresentacion          DateTime?
  updatedAt                  DateTime     @updatedAt
  createdAt                  DateTime     @default(now())

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, month])
  @@map("tax_declarations_month")
}

model SatBlacklist {
  id             String   @id @default(cuid())
  rfc            String   @unique
  razonSocial    String
  situacion      String   // "PRESUNTO", "DEFINITIVO", "DESVIRTUADO"
  publicacionDof DateTime
  oficio         String
  motivo         String?
  createdAt      DateTime @default(now())

  @@map("sat_blacklist")
}

model FiscalAlert {
  id             String       @id @default(cuid())
  organizationId String
  tipo           String       // "EFOS_DETECTADO", "OPINION_CUMPLIMIENTO", "VENCIMIENTO_PROXIMO", "PPD_SIN_PAGO", "CFDI_CANCELADO"
  titulo         String
  descripcion    String
  severidad      String       @default("INFO") // "INFO", "WARNING", "CRITICAL"
  leida          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fiscal_alerts")
}

model BankTransaction {
  id                  String       @id @default(cuid())
  organizationId      String
  fecha               DateTime
  concepto            String
  monto               Decimal      @db.Decimal(14, 2)
  tipo                String       // "CARGO" | "ABONO"
  referencia          String?
  cfdiUuidRelacionado String?
  conciliado          Boolean      @default(false)
  fechaConciliacion   DateTime?
  createdAt           DateTime     @default(now())

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, fecha])
  @@map("bank_transactions")
}

model CertificateVault {
  id                 String       @id @default(cuid())
  organizationId     String
  tipo               String       // "CSD" | "EFIRMA"
  rfc                String
  noCertificado      String?
  validoDesde        DateTime?
  validoHasta        DateTime?
  encryptedCer       String       @db.Text
  cerIv              String
  cerTag             String
  encryptedKey       String       @db.Text
  keyIv              String
  keyTag             String
  encryptedPassword  String       @db.Text
  passwordIv         String
  passwordTag        String
  activo             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, tipo])
  @@map("certificate_vault")
}

enum AuditAction {
  LOGIN
  TIMBRAR
  CANCELAR
  SUBIR_CERT
  BORRAR_CERT
  CAMBIO_PLAN
  CAMBIO_RFC
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  userEmail      String?
  action         AuditAction
  detalles       String?       @db.Text
  ip             String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

