generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CONTADOR
  ADMIN
}

enum TipoPersona {
  PF
  PM
}

enum Plan {
  FREE
  PRO
  DESPACHO
}

model User {
  id               String               @id @default(cuid())
  email            String               @unique
  name             String
  password         String
  role             Role                 @default(USER)
  isDespacho       Boolean              @default(false)
  activeCompanyId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  memberships      OrganizationMember[]
  subscription     Subscription?
  auditLogs        AuditLog[]
  passwordResetTokens PasswordResetToken[]
  satSyncJobs      SatSyncJob[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             Plan      @default(FREE)
  status           String    @default("ACTIVE") // "ACTIVE", "TRIAL", "CANCELLED"
  periodEnd        DateTime?
  timbresIncluidos Int       @default(10)
  timbresUsados    Int       @default(0)
  mpPaymentId      String?   // último payment_id de MercadoPago
  mpStatus         String?   // "approved", "pending", "rejected"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Organization {
  id                   String               @id @default(cuid())
  rfc                  String               @unique
  razonSocial          String
  tipoPersona          TipoPersona          @default(PF)
  regimenFiscal        String               // "626" RESICO, "612" Actividad Empresarial, "606" Arrendamiento, "601" PM General
  codigoPostal         String               // 5 dígitos
  calle                String?
  colonia              String?
  municipio            String?
  estado               String?
  coeficienteUtilidad  Decimal?             @default(0.0825) @db.Decimal(8, 4) // Para PM General
  deduccionCiega       Boolean              @default(true)   // Para Arrendamiento PF (35%)
  csdStatus            String               @default("ACTIVO") // "ACTIVO", "PENDIENTE", "REVOCADO"
  csdNoCertificado     String?              @default("30001000000500003416")
  csdVencimiento       DateTime?
  serieDefault         String               @default("F")
  folioActual          Int                  @default(1)
  opinionCumplimiento  String               @default("POSITIVA") // "POSITIVA", "NEGATIVA"
  efosStatus           String               @default("LIMPIO")   // "LIMPIO", "EN_OBSERVACION"
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  members              OrganizationMember[]
  invoices             Invoice[]
  polizas              Poliza[]
  taxDeclarations      TaxDeclarationMonth[]
  fiscalAlerts         FiscalAlert[]
  catalogAccounts      SatCatalogAccount[]
  bankTransactions     BankTransaction[]
  certificates         CertificateVault[]
  auditLogs            AuditLog[]
  satSyncJobs          SatSyncJob[]
  employees            Employee[]
  payrollPeriods       PayrollPeriod[]
  payrollReceipts      PayrollReceipt[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("OWNER") // "OWNER", "CONTADOR", "AUXILIAR"
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organization_members")
}

model Invoice {
  id                   String              @id @default(cuid())
  organizationId       String
  tipo                 String              // "EMITIDA", "RECIBIDA"
  tipoDeComprobante    String              @default("I") // "I" Ingreso, "E" Egreso, "P" Pago, "T" Traslado, "N" Nomina
  serie                String?
  folio                String?
  uuid                 String              @unique
  fecha                DateTime
  formaPago            String              @default("03") // "01" Efectivo, "03" Transferencia, "04" Tarjeta, "99" Por definir
  metodoPago           String              @default("PUE") // "PUE", "PPD"
  lugarExpedicion      String              // Código Postal
  moneda               String              @default("MXN")
  tipoCambio           Decimal             @default(1.0) @db.Decimal(12, 4)
  subtotal             Decimal             @db.Decimal(14, 2)
  descuento            Decimal             @default(0.0) @db.Decimal(14, 2)
  total                Decimal             @db.Decimal(14, 2)
  
  // Emisor
  emisorRfc            String
  emisorNombre         String
  emisorRegimen        String
  
  // Receptor
  receptorRfc          String
  receptorNombre       String
  receptorCp           String
  receptorRegimen      String
  receptorUsoCfdi      String              @default("G03")
  
  // Impuestos
  totalIvaTrasladado   Decimal             @default(0.0) @db.Decimal(14, 2)
  totalIvaRetenido     Decimal             @default(0.0) @db.Decimal(14, 2)
  totalIsrRetenido     Decimal             @default(0.0) @db.Decimal(14, 2)
  
  // Estatus SAT
  estatus              String              @default("VIGENTE") // "VIGENTE", "CANCELADO"
  fechaTimbrado        DateTime?
  selloCFD             String?             @db.Text
  selloSAT             String?             @db.Text
  noCertificadoSAT     String?             @default("00001000000504465028")
  cadenaOriginal       String?             @db.Text
  qrCodeData           String?             @db.Text
  rawXml               String?             @db.Text
  
  // Conciliación PUE / PPD
  saldoPendiente       Decimal             @default(0.0) @db.Decimal(14, 2)
  fechaEfectivoCobro   DateTime?
  estaConciliada       Boolean             @default(false)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items                InvoiceItem[]
  paymentComplements   PaymentComplement[] @relation("InvoicePpd")
  polizas              Poliza[]

  @@index([organizationId, tipo, fecha])
  @@index([uuid])
  @@index([emisorRfc])
  @@index([receptorRfc])
  @@map("invoices")
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  claveProdServ  String   // Ej. "80141600" Servicios contables
  claveUnidad    String   @default("E48")
  unidad         String?  @default("Servicio")
  descripcion    String
  cantidad       Decimal  @default(1.0) @db.Decimal(12, 4)
  valorUnitario  Decimal  @db.Decimal(14, 2)
  importe        Decimal  @db.Decimal(14, 2)
  descuento      Decimal  @default(0.0) @db.Decimal(14, 2)
  objetoImp      String   @default("02") // 01 No objeto, 02 Sí objeto
  ivaTasa        Decimal  @default(0.16) @db.Decimal(8, 4)
  ivaImporte     Decimal  @default(0.0) @db.Decimal(14, 2)
  retIsrTasa     Decimal? @default(0.0) @db.Decimal(8, 4)
  retIsrImporte  Decimal? @default(0.0) @db.Decimal(14, 2)
  retIvaTasa     Decimal? @default(0.0) @db.Decimal(8, 4)
  retIvaImporte  Decimal? @default(0.0) @db.Decimal(14, 2)

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model PaymentComplement {
  id             String   @id @default(cuid())
  invoicePpdId   String   // Factura original PPD
  uuidPago       String?  // UUID del CFDI tipo Pago emitido
  fechaPago      DateTime
  formaPago      String   @default("03") // SPEI
  monto          Decimal  @db.Decimal(14, 2)
  numParcialidad Int      @default(1)
  saldoAnterior  Decimal  @db.Decimal(14, 2)
  saldoInsoluto  Decimal  @db.Decimal(14, 2)
  monedaPago     String   @default("MXN")
  createdAt      DateTime @default(now())

  invoicePpd     Invoice  @relation("InvoicePpd", fields: [invoicePpdId], references: [id], onDelete: Cascade)

  @@map("payment_complements")
}

model Poliza {
  id               String        @id @default(cuid())
  organizationId   String
  invoiceId        String?
  tipo             String        // "INGRESO", "EGRESO", "DIARIO"
  numero           Int
  fecha            DateTime
  concepto         String
  uuidRelacionado  String?
  totalDebe        Decimal       @default(0.0) @db.Decimal(14, 2)
  totalHaber       Decimal       @default(0.0) @db.Decimal(14, 2)
  estaCuadrada     Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  entries          PolizaEntry[]

  @@map("polizas")
}

model PolizaEntry {
  id           String  @id @default(cuid())
  polizaId     String
  cuentaCodigo String  // Código Agrupador SAT, ej: 102.01, 105.01, 401.01
  cuentaNombre String
  concepto     String?
  debe         Decimal @default(0.0) @db.Decimal(14, 2)
  haber        Decimal @default(0.0) @db.Decimal(14, 2)

  poliza       Poliza  @relation(fields: [polizaId], references: [id], onDelete: Cascade)

  @@map("poliza_entries")
}

model SatCatalogAccount {
  id             String       @id @default(cuid())
  organizationId String
  codigoSat      String       // Ej. 102.01, 105.01, 201.01, 401.01
  nombre         String
  tipo           String       // "ACTIVO", "PASIVO", "CAPITAL", "RESULTADOS_ACREEDORA", "RESULTADOS_DEUDORA"
  nivel          Int          @default(2)
  saldoInicial   Decimal      @default(0.0) @db.Decimal(14, 2)
  cargos         Decimal      @default(0.0) @db.Decimal(14, 2)
  abonos         Decimal      @default(0.0) @db.Decimal(14, 2)
  saldoFinal     Decimal      @default(0.0) @db.Decimal(14, 2)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, codigoSat])
  @@map("sat_catalog_accounts")
}

model TaxDeclarationMonth {
  id                         String       @id @default(cuid())
  organizationId             String
  year                       Int          @default(2026)
  month                      Int          // 1 - 12
  regimen                    String       // "626", "612", "606", "601"
  ingresosCobrados           Decimal      @default(0.0) @db.Decimal(14, 2)
  deduccionesPagadas         Decimal      @default(0.0) @db.Decimal(14, 2)
  baseGravable               Decimal      @default(0.0) @db.Decimal(14, 2)
  tasaIsr                    Decimal      @default(0.0) @db.Decimal(8, 4)
  isrDeterminado             Decimal      @default(0.0) @db.Decimal(14, 2)
  retencionesIsr             Decimal      @default(0.0) @db.Decimal(14, 2)
  pagosProvisionalesPrevios  Decimal      @default(0.0) @db.Decimal(14, 2)
  isrAPagar                  Decimal      @default(0.0) @db.Decimal(14, 2)
  ivaCobrado                 Decimal      @default(0.0) @db.Decimal(14, 2)
  ivaPagado                  Decimal      @default(0.0) @db.Decimal(14, 2)
  retencionesIva             Decimal      @default(0.0) @db.Decimal(14, 2)
  ivaAPagar                  Decimal      @default(0.0) @db.Decimal(14, 2)
  estatus                    String       @default("CALCULADO") // "CALCULADO", "PRESENTADA", "PAGADA"
  lineaCaptura               String?
  fechaLimite                DateTime?
  fechaPresentacion          DateTime?
  updatedAt                  DateTime     @updatedAt
  createdAt                  DateTime     @default(now())

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, month])
  @@map("tax_declarations_month")
}

model SatBlacklist {
  id             String   @id @default(cuid())
  rfc            String   @unique
  razonSocial    String
  situacion      String   // "PRESUNTO", "DEFINITIVO", "DESVIRTUADO"
  publicacionDof DateTime
  oficio         String
  motivo         String?
  createdAt      DateTime @default(now())

  @@map("sat_blacklist")
}

model FiscalAlert {
  id             String       @id @default(cuid())
  organizationId String
  tipo           String       // "EFOS_DETECTADO", "OPINION_CUMPLIMIENTO", "VENCIMIENTO_PROXIMO", "PPD_SIN_PAGO", "CFDI_CANCELADO"
  titulo         String
  descripcion    String
  severidad      String       @default("INFO") // "INFO", "WARNING", "CRITICAL"
  leida          Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("fiscal_alerts")
}

model BankTransaction {
  id                  String       @id @default(cuid())
  organizationId      String
  fecha               DateTime
  concepto            String
  monto               Decimal      @db.Decimal(14, 2)
  tipo                String       // "CARGO" | "ABONO"
  referencia          String?
  cfdiUuidRelacionado String?
  conciliado          Boolean      @default(false)
  fechaConciliacion   DateTime?
  createdAt           DateTime     @default(now())

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, fecha])
  @@map("bank_transactions")
}

model CertificateVault {
  id                 String       @id @default(cuid())
  organizationId     String
  tipo               String       // "CSD" | "EFIRMA"
  rfc                String
  noCertificado      String?
  validoDesde        DateTime?
  validoHasta        DateTime?
  encryptedCer       String       @db.Text
  cerIv              String
  cerTag             String
  encryptedKey       String       @db.Text
  keyIv              String
  keyTag             String
  encryptedPassword  String       @db.Text
  passwordIv         String
  passwordTag        String
  activo             Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, tipo])
  @@map("certificate_vault")
}

enum AuditAction {
  LOGIN
  TIMBRAR
  CANCELAR
  SUBIR_CERT
  BORRAR_CERT
  CAMBIO_PLAN
  CAMBIO_RFC
  SINCRONIZAR_SAT
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  userEmail      String?
  action         AuditAction
  detalles       String?       @db.Text
  ip             String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

enum SatSyncTipo {
  EMITIDAS
  RECIBIDAS
  TODAS
}

enum SatSyncStatus {
  SOLICITADA
  EN_PROCESO
  COMPLETADA
  ERROR
}

model SatSyncJob {
  id                  String        @id @default(cuid())
  organizationId      String
  userId              String
  tipo                SatSyncTipo   @default(TODAS)
  fechaInicio         DateTime
  fechaFin            DateTime
  idSolicitudSat      String?
  status              SatSyncStatus @default(SOLICITADA)
  facturasProcesadas  Int           @default(0)
  facturasNuevas      Int           @default(0)
  mensaje             String?
  errorDetalle        String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("sat_sync_jobs")
}

// ==========================================
// MÓDULO DE NÓMINA CFDI 4.0 (COMPLEMENTO 1.2)
// ==========================================

enum PeriodicidadPago {
  DIARIO       // 01
  SEMANAL      // 02
  CATORCENAL   // 03
  QUINCENAL    // 04
  MENSUAL      // 05
}

enum TipoContrato {
  TIEMPO_INDETERMINADO // 01
  TIEMPO_DETERMINADO   // 02
  OBRA_DETERMINADA     // 03
  TEMPORADA            // 04
  PRUEBA               // 05
  CAPACITACION_INICIAL // 06
  MODALIDAD_ASIMILADOS // 09
}

enum TipoJornada {
  DIURNA       // 01
  NOCTURNA     // 02
  MIXTA        // 03
  POR_HORA     // 04
  REDUCIDA     // 05
}

enum RegimenContratacion {
  SUELDOS_SALARIOS     // 02
  ASIMILADOS_HONORARIOS // 09
  ASIMILADOS_CONSEJO    // 10
}

enum EstatusEmpleado {
  ACTIVO
  INACTIVO
  BAJA
}

model Employee {
  id                   String              @id @default(cuid())
  organizationId       String
  numeroEmpleado       String              // p. ej. EMP-001
  nombre               String
  primerApellido       String
  segundoApellido      String?
  rfc                  String              // 13 posiciones para PF
  curp                 String              // 18 posiciones
  nss                  String?             // 11 dígitos IMSS
  codigoPostal         String              // Domicilio fiscal del receptor (según Constancia SAT)
  email                String?
  telefono             String?
  
  // Datos Laborales
  fechaInicioRelLaboral DateTime           @default(now())
  departamento         String?             @default("General")
  puesto               String              @default("Operativo")
  tipoContrato         TipoContrato        @default(TIEMPO_INDETERMINADO)
  tipoJornada          TipoJornada         @default(DIURNA)
  regimenContratacion  RegimenContratacion @default(SUELDOS_SALARIOS)
  periodicidadPago     PeriodicidadPago    @default(QUINCENAL)
  
  // Salarios base
  salarioDiario        Decimal             @db.Decimal(12, 2)
  salarioBaseCotApor   Decimal             @db.Decimal(12, 2) // SBC para IMSS
  salarioDiarioInteg   Decimal             @db.Decimal(12, 2) // SDI
  
  // Dispersión bancaria
  bancoClave           String?             // Clave SPEI del banco (ej. 012 BBVA, 002 Banamex)
  cuentaBancaria       String?             // CLABE 18 dígitos o cuenta
  
  status               EstatusEmpleado     @default(ACTIVO)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipts             PayrollReceipt[]

  @@unique([organizationId, numeroEmpleado])
  @@index([organizationId, status])
  @@index([organizationId, rfc])
  @@map("employees")
}

enum TipoNomina {
  ORDINARIA      // O
  EXTRAORDINARIA // E
}

enum EstatusNomina {
  BORRADOR
  CALCULADA
  TIMBRADA
  CANCELADA
}

model PayrollPeriod {
  id                   String          @id @default(cuid())
  organizationId       String
  tipoNomina           TipoNomina      @default(ORDINARIA)
  descripcion          String          // Ej. "1ra Quincena Septiembre 2026"
  periodicidad         PeriodicidadPago @default(QUINCENAL)
  fechaInicio          DateTime
  fechaFin             DateTime
  fechaPago            DateTime
  diasPagados          Decimal         @default(15) @db.Decimal(5, 2)
  
  // Totales calculados del lote
  totalPercepciones    Decimal         @default(0) @db.Decimal(14, 2)
  totalDeducciones     Decimal         @default(0) @db.Decimal(14, 2)
  totalRetencionIsr    Decimal         @default(0) @db.Decimal(14, 2)
  totalImssObrero      Decimal         @default(0) @db.Decimal(14, 2)
  totalOtrosPagos      Decimal         @default(0) @db.Decimal(14, 2)
  totalNeto            Decimal         @default(0) @db.Decimal(14, 2)
  
  status               EstatusNomina   @default(BORRADOR)
  polizaGenerada       Boolean         @default(false)
  polizaId             String?
  
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipts             PayrollReceipt[]

  @@index([organizationId, fechaPago])
  @@index([organizationId, status])
  @@map("payroll_periods")
}

model PayrollReceipt {
  id                   String          @id @default(cuid())
  organizationId       String
  payrollPeriodId      String
  employeeId           String
  
  // Datos del cálculo
  diasTrabajados       Decimal         @default(15) @db.Decimal(5, 2)
  sueldoBruto          Decimal         @db.Decimal(12, 2)
  
  // Desglose JSON de Percepciones y Deducciones según catálogo SAT
  // Percepciones: { code: "001", description: "Sueldos y Salarios", gravado: 5000, exento: 0 }
  percepciones         Json            @default("[]")
  totalPercepciones    Decimal         @db.Decimal(12, 2)
  totalPercepcionesGravadas Decimal    @default(0) @db.Decimal(12, 2)
  totalPercepcionesExentas  Decimal    @default(0) @db.Decimal(12, 2)
  
  // Deducciones: { code: "001", description: "IMSS Obrero", importe: 120.50 }, { code: "002", description: "ISR", importe: 450.00 }
  deducciones          Json            @default("[]")
  totalDeducciones     Decimal         @db.Decimal(12, 2)
  retencionIsr         Decimal         @default(0) @db.Decimal(12, 2)
  imssObrero           Decimal         @default(0) @db.Decimal(12, 2)
  
  // Otros Pagos (ej. 002 Subsidio para el empleo)
  otrosPagos           Json            @default("[]")
  totalOtrosPagos      Decimal         @default(0) @db.Decimal(12, 2)
  
  // Neto a transferir
  netoPagar            Decimal         @db.Decimal(12, 2)
  
  // CFDI 4.0 Timbrado
  status               EstatusNomina   @default(CALCULADA)
  uuid                 String?         @unique
  serie                String?         @default("NOM")
  folio                String?
  fechaTimbrado        DateTime?
  selloSat             String?         @db.Text
  selloCfd             String?         @db.Text
  noCertificadoSat     String?
  cadenaOriginalSat    String?         @db.Text
  xmlSat               String?         @db.Text
  errorTimbrado        String?         @db.Text

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollPeriod        PayrollPeriod   @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee             Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, employeeId])
  @@index([payrollPeriodId])
  @@index([uuid])
  @@map("payroll_receipts")
}


